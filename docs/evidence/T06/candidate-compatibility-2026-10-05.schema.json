{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "number",
      "const": 1
    },
    "enabled": {
      "type": "boolean",
      "const": true
    },
    "numericConst": {
      "type": "number",
      "const": 7
    },
    "decimalId": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "nested": {
      "$ref": "#/$defs/Nested"
    }
  },
  "required": [
    "protocol",
    "enabled",
    "numericConst",
    "decimalId",
    "nested"
  ],
  "additionalProperties": false,
  "$defs": {
    "Nested": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false
    }
  }
}
